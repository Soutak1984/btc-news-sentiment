# Copy this file to telegram.env. Do not commit telegram.env.

# Token from @BotFather. It looks like 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to query the bot.
# Send /start or /whoami to the bot and it will reply with your id.
# For a group, add the group's negative chat id as well.
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_USER_IDS=

# Minutes between automatic news collection inside the bot.
# Use 0 when the systemd timer is the only collector.
COLLECT_INTERVAL_MINUTES=15

# Set to 1 to also serve the local web dashboard.
SERVE_WEB=0
WEB_HOST=127.0.0.1
WEB_PORT=8080
